# voice-pilot settings. Copy to .env (gitignored) and fill in; keys are read from the environment only, never from the repo.
# The same names work for the Python server (server/) and the Next.js port (server-node/).

# --- the model (Anthropic) ---
ANTHROPIC_API_KEY=
PILOT_MODEL=claude-sonnet-5-5
PILOT_EFFORT=low                 # low | medium | high | xhigh | max (with adaptive thinking)
PILOT_THINKING=adaptive          # adaptive, or between_tools (Sonnet 5.5 only: no extended thinking, lowest latency)
PILOT_FALLBACKS=default          # default = server-side refusal fallback (beta server-side-fallback-2026-07-01, Claude API); off = none
PILOT_MAX_TOKENS=4096
PILOT_MAX_STEPS=5                # model calls per question; the last one may not call tools
PILOT_MAX_ACTIONS=8              # UI actions per answer
PILOT_TIMEOUT_S=30
PILOT_TURN_DEADLINE_S=45
PILOT_ASSISTANT_NAME=Aava

# --- limits (in memory, reset on restart) ---
PILOT_RATE_PER_MIN=12            # questions per IP per minute
PILOT_DAILY_TURNS=400            # questions per UTC day, all visitors
PILOT_INPUT_CHARS=600
PILOT_HISTORY_TURNS=10

# --- the voice (ElevenLabs); without these the browser's own voice speaks ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2   # eleven_flash_v2_5 starts faster
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
PILOT_TTS_DAILY_CHARS=20000      # spoken characters per UTC day; cached repeats are free
PILOT_TTS_MAX_CHARS=600          # per request
PILOT_TTS_CACHE_ITEMS=200

# --- rehearsal mode: the real loop with a scripted plan, labelled "Rehearsal" in the overlay ---
PILOT_REHEARSAL=0
